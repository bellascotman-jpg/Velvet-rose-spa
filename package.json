{
  "name": "velvet-rose-spa",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "emulators": "firebase emulators:start --project demo-velvet-rose --only auth,firestore",
    "emulators:export": "firebase emulators:export ./emulator-data --project demo-velvet-rose",
    "build": "node scripts/copy-static.mjs",
    "test:rules": "firebase emulators:exec --project demo-velvet-rose --only firestore \"node --test tests/firestore.rules.test.mjs\""
  },
  "devDependencies": {
    "firebase-tools": "^14.0.0",
    "firebase": "^10.14.1",
    "@firebase/rules-unit-testing": "^4.0.1"
  }
}
